# Example environment. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is git ignored and must never be committed. This file carries variable
# names and safe defaults only, never a real key.
#
# Every value below has a default in app/config.py, so an empty .env is valid
# and the gateway starts. The defaults are the ones that run offline with no
# credentials. Override what you actually need.

# --- provider credentials ------------------------------------------------
# Read without the SEMCACHE_ prefix, because that is the name the provider
# SDKs and every deployment guide already use. Leave blank while running on
# the stub provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- state stores --------------------------------------------------------
# Defaults target localhost, for running the gateway outside Compose.
# docker-compose.yml overrides both with service names on the internal network.
# Chroma is on 8001 locally because the gateway holds 8000.
SEMCACHE_REDIS_URL=redis://localhost:6379/0
SEMCACHE_CHROMA_HOST=http://localhost:8001

# --- cache behaviour -----------------------------------------------------
# The benchmark sweeps the threshold across 0.75, 0.90 and 0.95, so this is a
# configuration value rather than a constant. Must be between 0 and 1.
SEMCACHE_SIMILARITY_THRESHOLD=0.90
SEMCACHE_CACHE_TTL_SECONDS=3600

# --- admission control ---------------------------------------------------
# Capacity is in provider tokens, not requests, because that is the unit
# providers enforce and a request count does not protect against long prompts.
# The limiter is off by default, so a local gateway never throttles. Turn it on
# to enforce the budget below, per API key.
SEMCACHE_LIMITER_ENABLED=false
SEMCACHE_BUCKET_CAPACITY=100000
SEMCACHE_BUCKET_REFILL_RATE=1000
# Tokens reserved for the reply when a request sets no max_tokens.
SEMCACHE_LIMITER_DEFAULT_COMPLETION_TOKENS=256

# --- providers -----------------------------------------------------------
# stub, openai or anthropic. The default is stub, which needs no credentials
# and no network. Set openai for a real deployment.
SEMCACHE_PRIMARY_PROVIDER=stub
# The provider to fail over to when the primary is unhealthy. Leave it unset for
# no failover. It is commented out on purpose: setting it makes the gateway
# refuse to start without that provider's key, and it must differ from the
# primary. SEMCACHE_SECONDARY_MODEL is the model it is called with, because one
# vendor's model name means nothing to another; unset uses the provider's default.
# SEMCACHE_SECONDARY_PROVIDER=anthropic
# SEMCACHE_SECONDARY_MODEL=claude-3-haiku-20240307
# Where the adapters send requests, for a proxy or a compatible endpoint.
SEMCACHE_OPENAI_BASE_URL=https://api.openai.com/v1
SEMCACHE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Seconds one provider call may take before it counts as a failure and can trip
# the breaker. Generous, since a long completion legitimately takes a while.
SEMCACHE_PROVIDER_TIMEOUT_SECONDS=30

# --- circuit breaker -----------------------------------------------------
SEMCACHE_BREAKER_FAILURE_THRESHOLD=5
SEMCACHE_BREAKER_WINDOW_SECONDS=60
SEMCACHE_BREAKER_BASE_BACKOFF=1.0
SEMCACHE_BREAKER_BACKOFF_CEILING=60.0

# --- embedding -----------------------------------------------------------
# Baked into the image at build time, so a running container needs no outbound
# access to embed a prompt.
SEMCACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Tier 2 semantic cache -------------------------------------------------
# Off by default so the gateway runs without a vector store. docker-compose.yml
# turns it on. When on and Chroma is unreachable, the gateway degrades to Tier 1
# only rather than failing requests.
SEMCACHE_SEMANTIC_CACHE_ENABLED=false
# Seconds between passes that delete expired Tier 2 entries, or 0 to never.
# Expired entries are never served either way; this only reclaims the space.
SEMCACHE_EVICTION_INTERVAL_SECONDS=300
# Carries a schema version, so changing the stored shape means a new name.
# Three to 512 characters of letters, digits, dot, underscore and hyphen.
SEMCACHE_CHROMA_COLLECTION=semcache-v1
# Seconds to wait before retrying Chroma after a failed connection.
SEMCACHE_CHROMA_RECONNECT_SECONDS=30
# Seconds one call to Chroma may take before it counts as an outage. A hung
# vector store raises nothing, so without this a request would wait on it.
SEMCACHE_CHROMA_TIMEOUT_SECONDS=2

# --- model routing -------------------------------------------------------
# When enabled, single-turn short prompts (no code fence, under the token
# ceiling) are sent to the cheap model instead of whatever the caller asked
# for. The cache key always uses the requested model, so changing the routing
# rule does not invalidate existing entries (PRD section 33.7).
# routing_cheap_model is required when routing_enabled=true.
SEMCACHE_ROUTING_ENABLED=false
# SEMCACHE_ROUTING_CHEAP_MODEL=gpt-4o-mini
SEMCACHE_ROUTING_SIMPLE_MAX_TOKENS=512

# --- observability -------------------------------------------------------
# Tracing is off by default, so nothing needs a collector to run. A bare
# collector address is accepted and pointed at /v1/traces, because the OTLP
# exporter posts to an endpoint given in code exactly as written.
SEMCACHE_TRACING_ENABLED=false
# When running under docker-compose, set to the Jaeger OTLP/HTTP ingest:
#   SEMCACHE_OTEL_EXPORTER_ENDPOINT=http://jaeger:4318
# For a local run against a local Jaeger, use the published port:
#   SEMCACHE_OTEL_EXPORTER_ENDPOINT=http://localhost:4318
SEMCACHE_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Prompt text is caller data. Switch this on only in development.
SEMCACHE_LOG_PROMPTS=false

# --- metrics -------------------------------------------------------------
# Number of latency samples kept per bucket (hit/miss). Exact percentiles are
# computed over the most recent N samples only. The /metrics snapshot includes
# latency_window so a reader knows what the p95 is computed over.
SEMCACHE_METRICS_LATENCY_WINDOW=10000

# --- authentication ------------------------------------------------------
# Whether a caller must present an Authorization header. The key is the
# identity a token budget is charged against.
SEMCACHE_REQUIRE_API_KEY=true

# --- request limits ------------------------------------------------------
# The largest request body accepted, in bytes. Anything bigger is refused with
# a 413 before it is parsed. The default is 1 MiB.
SEMCACHE_MAX_REQUEST_BYTES=1048576
