# Example environment. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is git ignored and must never be committed. This file carries variable
# names and safe defaults only, never a real key.
#
# Every value below has a default in app/config.py, so an empty .env is valid
# and the gateway starts. The defaults are the ones that run offline with no
# credentials. Override what you actually need.

# --- provider credentials ------------------------------------------------
# Read without the SEMCACHE_ prefix, because that is the name the provider
# SDKs and every deployment guide already use. Leave blank while running on
# the stub provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- state stores --------------------------------------------------------
# Defaults target localhost, for running the gateway outside Compose.
# docker-compose.yml overrides both with service names on the internal network.
# Chroma is on 8001 locally because the gateway holds 8000.
SEMCACHE_REDIS_URL=redis://localhost:6379/0
SEMCACHE_CHROMA_HOST=http://localhost:8001

# --- cache behaviour -----------------------------------------------------
# The benchmark sweeps the threshold across 0.75, 0.90 and 0.95, so this is a
# configuration value rather than a constant. Must be between 0 and 1.
SEMCACHE_SIMILARITY_THRESHOLD=0.90
SEMCACHE_CACHE_TTL_SECONDS=3600

# --- admission control ---------------------------------------------------
# Capacity is in provider tokens, not requests, because that is the unit
# providers enforce and a request count does not protect against long prompts.
SEMCACHE_BUCKET_CAPACITY=100000
SEMCACHE_BUCKET_REFILL_RATE=1000

# --- providers -----------------------------------------------------------
# stub, openai or anthropic. The default is stub, which needs no credentials
# and no network. Set openai for a real deployment.
SEMCACHE_PRIMARY_PROVIDER=stub
SEMCACHE_SECONDARY_PROVIDER=anthropic

# --- circuit breaker -----------------------------------------------------
SEMCACHE_BREAKER_FAILURE_THRESHOLD=5
SEMCACHE_BREAKER_WINDOW_SECONDS=60
SEMCACHE_BREAKER_BASE_BACKOFF=1.0
SEMCACHE_BREAKER_BACKOFF_CEILING=60.0

# --- embedding -----------------------------------------------------------
# Baked into the image at build time, so a running container needs no outbound
# access to embed a prompt.
SEMCACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- observability -------------------------------------------------------
# Prompt text is caller data. Switch this on only in development.
SEMCACHE_LOG_PROMPTS=false

# --- authentication ------------------------------------------------------
# Whether a caller must present an Authorization header. The key is the
# identity a token budget is charged against.
SEMCACHE_REQUIRE_API_KEY=true
